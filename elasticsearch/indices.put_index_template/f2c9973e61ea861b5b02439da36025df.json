{
  "api": "indices.put_index_template",
  "file": "/test/free/data_stream/291_columnar_template_mode_switch.yml",
  "name": "Switch the template from time_series to columnar with multi_value",
  "origin": "yaml",
  "request": {
    "args": {
      "body": {
        "data_stream": {
        },
        "index_patterns": [
          "tsdb-mv-ds*"
        ],
        "template": {
          "mappings": {
            "properties": {
              "@timestamp": {
                "type": "date"
              },
              "dim": {
                "time_series_dimension": true,
                "type": "keyword"
              }
            }
          },
          "settings": {
            "index": {
              "mode": "time_series",
              "routing_path": [
                "dim"
              ]
            }
          }
        }
      },
      "name": "tsdb-mv-template"
    }
  },
  "response": {
    "headers": {
      "content-length": "21",
      "content-type": "application/json",
      "date": "Sat, 28 Nov 2026 10:19:39 GMT",
      "x-elastic-product": "Elasticsearch"
    },
    "payload": {
      "acknowledged": true
    },
    "statusCode": 200
  }
}