{
  "api": "indices.put_index_template",
  "file": "/test/free/simulate.ingest/20_template_index_mode.yml",
  "name": "Simulate with a columnar template that uses multi_value",
  "origin": "yaml",
  "request": {
    "args": {
      "body": {
        "index_patterns": [
          "mv-sim*"
        ],
        "template": {
          "mappings": {
            "properties": {
              "kw": {
                "multi_value": false,
                "type": "keyword"
              }
            }
          },
          "settings": {
            "index": {
              "mode": "columnar"
            }
          }
        }
      },
      "name": "mv-sim-template"
    }
  },
  "response": {
    "headers": {
      "content-length": "21",
      "content-type": "application/json",
      "date": "Wed, 25 Nov 2026 10:44:12 GMT",
      "x-elastic-product": "Elasticsearch"
    },
    "payload": {
      "acknowledged": true
    },
    "statusCode": 200
  }
}