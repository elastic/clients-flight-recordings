{
  "api": "indices.put_index_template",
  "file": "/test/free/data_stream/10_basic.yml",
  "name": "Get data streams returns the index mode of the next backing index",
  "origin": "yaml",
  "request": {
    "args": {
      "body": {
        "data_stream": {
        },
        "index_patterns": [
          "data-*"
        ],
        "template": {
          "mappings": {
            "properties": {
              "@timestamp": {
                "type": "date"
              },
              "cpu_usage": {
                "time_series_metric": "gauge",
                "type": "double"
              },
              "pod_name": {
                "time_series_dimension": true,
                "type": "keyword"
              }
            }
          },
          "settings": {
            "index": {
              "mode": "time_series",
              "number_of_replicas": 0,
              "number_of_shards": 1,
              "routing_path": [
                "pod_name"
              ]
            }
          }
        }
      },
      "name": "my-template"
    }
  },
  "response": {
    "headers": {
      "content-length": "21",
      "content-type": "application/json",
      "date": "Tue, 20 Oct 2026 10:17:17 GMT",
      "x-elastic-product": "Elasticsearch"
    },
    "payload": {
      "acknowledged": true
    },
    "statusCode": 200
  }
}