{
  "api": "indices.put_index_template",
  "file": "/test/free/data_stream/291_columnar_template_mode_switch.yml",
  "name": "Switch to logsdb with a routing partition size",
  "origin": "yaml",
  "request": {
    "args": {
      "body": {
        "data_stream": {
          "allow_custom_routing": true
        },
        "index_patterns": [
          "partition-ds*"
        ],
        "template": {
          "mappings": {
            "_routing": {
              "required": true
            },
            "properties": {
              "@timestamp": {
                "type": "date"
              }
            }
          },
          "settings": {
            "index": {
              "mode": "logsdb",
              "routing_partition_size": 2
            }
          }
        }
      },
      "name": "partition-template"
    }
  },
  "response": {
    "headers": {
      "content-length": "21",
      "content-type": "application/json",
      "date": "Wed, 25 Nov 2026 10:20:33 GMT",
      "x-elastic-product": "Elasticsearch"
    },
    "payload": {
      "acknowledged": true
    },
    "statusCode": 200
  }
}