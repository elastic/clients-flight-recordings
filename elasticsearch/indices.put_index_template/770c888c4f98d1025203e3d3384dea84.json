{
  "api": "indices.put_index_template",
  "file": "/test/free/simulate.ingest/20_template_index_mode.yml",
  "name": "Simulate with a time_series template",
  "origin": "yaml",
  "request": {
    "args": {
      "body": {
        "index_patterns": [
          "tsdb-sim*"
        ],
        "template": {
          "mappings": {
            "properties": {
              "@timestamp": {
                "type": "date"
              },
              "dim": {
                "time_series_dimension": true,
                "type": "keyword"
              }
            }
          },
          "settings": {
            "index": {
              "mode": "time_series",
              "routing_path": [
                "dim"
              ],
              "time_series": {
                "end_time": "2021-04-29T00:00:00Z",
                "start_time": "2021-04-28T00:00:00Z"
              }
            }
          }
        }
      },
      "name": "tsdb-sim-template"
    }
  },
  "response": {
    "headers": {
      "content-length": "21",
      "content-type": "application/json",
      "date": "Thu, 26 Nov 2026 10:43:35 GMT",
      "x-elastic-product": "Elasticsearch"
    },
    "payload": {
      "acknowledged": true
    },
    "statusCode": 200
  }
}