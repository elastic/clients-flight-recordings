          "mappings": {
            "properties": {
              "@timestamp": {
                "type": "date"
              },
              "dim": {
                "time_series_dimension": true,
                "type": "keyword"
              }
            }
          },
          "settings": {
            "index": {
              "mode": "time_series",
              "routing_path": [
                "dim"
              ]
            }
          }
        }
      },
      "name": "tsds-sim-template"
    }
  },
