{
  "api": "indices.put_index_template",
  "file": "/test/free/simulate.ingest/20_template_index_mode.yml",
  "name": "Simulate with a time_series data stream template and a timestamp outside the time range",
  "origin": "yaml",
  "request": {
    "args": {
      "body": {
        "data_stream": {
        },
        "index_patterns": [
          "tsds-sim*"
        ],
