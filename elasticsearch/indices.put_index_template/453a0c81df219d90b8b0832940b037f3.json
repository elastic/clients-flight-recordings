{
  "api": "indices.put_index_template",
  "file": "/test/free/indices.put_index_template/10_basic.yml",
  "name": "PUT index template with duplicate dynamic template names emits a warning",
  "origin": "yaml",
  "request": {
    "args": {
      "body": {
        "index_patterns": "test-dup-*",
        "template": {
          "mappings": {
            "dynamic_templates": [
              {
                "my_template": {
                  "mapping": {
                    "type": "keyword"
                  },
                  "match": "foo_*"
                }
              },
              {
                "my_template": {
                  "mapping": {
                    "type": "text"
                  },
                  "match": "bar_*"
                }
              }
            ]
          }
        }
      },
      "name": "test-dup-dynamic-templates"
    }
  },
  "response": {
    "headers": {
      "content-length": "21",
      "content-type": "application/json",
      "date": "Fri, 23 Oct 2026 10:27:17 GMT",
      "warning": "299 Elasticsearch-9.7.0-7acf1229e7b5fd083b24f19066a4d4b4c1d287f0 \"Dynamic template [my_template] in template [test-dup-dynamic-templates] is defined more than once. It is not defined which of the duplicate definitions takes effect. Defining multiple dynamic templates with the same name will be rejected in a future version.\"",
      "x-elastic-product": "Elasticsearch"
    },
    "payload": {
      "acknowledged": true
    },
    "statusCode": 200
  }
}