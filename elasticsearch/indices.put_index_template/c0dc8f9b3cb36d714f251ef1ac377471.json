{
  "api": "indices.put_index_template",
  "file": "/test/free/mapping/80_columnar_unmapped_fields.yml",
  "name": "an index template carries dynamic flattened to the indices it creates",
  "origin": "yaml",
  "request": {
    "args": {
      "body": {
        "index_patterns": [
          "dynamic-flattened-*"
        ],
        "template": {
          "mappings": {
            "dynamic": "flattened"
          },
          "settings": {
            "index": {
              "mode": "columnar"
            }
          }
        }
      },
      "name": "dynamic-flattened-template"
    }
  },
  "response": {
