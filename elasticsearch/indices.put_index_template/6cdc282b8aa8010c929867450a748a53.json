{
  "api": "indices.put_index_template",
  "file": "/test/free/data_stream/290_columnar.yml",
  "name": "Create logsdb_columnar data stream, index docs, and retrieve them",
  "origin": "yaml",
  "request": {
    "args": {
      "body": {
        "data_stream": {
        },
        "index_patterns": [
          "columnar-logsdb-logs*"
        ],
        "template": {
          "mappings": {
            "properties": {
              "@timestamp": {
                "type": "date"
              },
              "agent_id": {
                "type": "keyword"
              },
              "host.name": {
                "type": "keyword"
              },
              "message": {
                "type": "text"
              },
              "process_id": {
                "type": "integer"
              }
            }
          },
          "settings": {
            "index": {
              "mode": "logsdb_columnar",
              "number_of_replicas": 1
            }
          }
        }
      },
      "name": "columnar-logsdb-template"
    }
  },
  "response": {
    "headers": {
      "content-length": "21",
      "content-type": "application/json",
      "date": "Tue, 25 Aug 2026 10:21:15 GMT",
      "x-elastic-product": "Elasticsearch"
    },
    "payload": {
      "acknowledged": true
    },
    "statusCode": 200
  }
}