{
  "api": "indices.put_index_template",
  "file": "/test/free/data_stream/291_columnar_template_mode_switch.yml",
  "name": "Switch to columnar through a component template with multi_value",
  "origin": "yaml",
  "request": {
    "args": {
      "body": {
        "composed_of": [
          "mv-settings"
        ],
        "data_stream": {
        },
        "index_patterns": [
          "mv-ds*"
        ],
        "template": {
          "mappings": {
            "properties": {
              "@timestamp": {
                "type": "date"
              },
              "kw": {
                "multi_value": false,
                "type": "keyword"
              }
            }
          }
        }
      },
      "name": "mv-template"
    }
  },
  "response": {
    "headers": {
      "content-length": "21",
      "content-type": "application/json",
      "date": "Sat, 28 Nov 2026 10:19:39 GMT",
      "x-elastic-product": "Elasticsearch"
    },
    "payload": {
      "acknowledged": true
    },
    "statusCode": 200
  }
}