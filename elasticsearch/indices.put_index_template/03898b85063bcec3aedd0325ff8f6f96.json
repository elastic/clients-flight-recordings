{
  "api": "indices.put_index_template",
  "file": "/test/free/data_stream/150_tsdb.yml",
  "name": "dynamic templates - conflicting aliases with top-level field",
  "origin": "yaml",
  "request": {
    "args": {
      "body": {
        "data_stream": {
        },
        "index_patterns": [
          "otel"
        ],
        "template": {
          "mappings": {
            "dynamic_templates": [
              {
                "counter_metric": {
                  "mapping": {
                    "ignore_malformed": true,
                    "time_series_metric": "counter",
                    "type": "integer"
                  }
                }
              },
              {
                "strings_as_keyword": {
                  "mapping": {
                    "ignore_above": 1024,
                    "type": "keyword"
                  },
                  "match_mapping_type": "string",
                  "path_match": "*attributes.*"
                }
              }
            ],
            "properties": {
              "attributes": {
                "dynamic": true,
                "priority": 1,
                "time_series_dimension": true,
                "type": "passthrough"
              },
              "body": {
                "type": "match_only_text"
              },
              "metrics": {
                "dynamic": true,
                "priority": 0,
                "type": "passthrough"
              },
              "resource": {
                "properties": {
                  "attributes": {
                    "dynamic": true,
                    "priority": 3,
                    "time_series_dimension": true,
                    "type": "passthrough"
                  }
                }
              },
              "scope": {
                "properties": {
                  "attributes": {
                    "dynamic": true,
                    "priority": 2,
                    "time_series_dimension": true,
                    "type": "passthrough"
                  }
                }
              }
            }
          },
          "settings": {
            "index": {
              "mode": "time_series",
              "number_of_shards": 1,
              "time_series": {
                "start_time": "2023-08-31T13:03:08.138Z"
              }
            }
          }
        }
      },
      "name": "my-dynamic-template"
    }
  },
  "response": {
    "headers": {
      "content-length": "21",
      "content-type": "application/json",
      "date": "Fri, 28 Aug 2026 10:16:42 GMT",
      "x-elastic-product": "Elasticsearch"
    },
    "payload": {
      "acknowledged": true
    },
    "statusCode": 200
  }
}