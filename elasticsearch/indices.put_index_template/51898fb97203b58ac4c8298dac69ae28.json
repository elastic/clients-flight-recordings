{
  "api": "indices.put_index_template",
  "file": "/test/free/data_stream/150_tsdb.yml",
  "name": "TSDB documents for write blocked backing index go to failure store",
  "origin": "yaml",
  "request": {
    "args": {
      "body": {
        "data_stream": {
        },
        "index_patterns": [
          "tsdb-write-blocked*"
        ],
        "template": {
          "data_stream_options": {
            "failure_store": {
              "enabled": true
            }
          },
          "mappings": {
            "properties": {
              "@timestamp": {
                "type": "date"
              },
              "metricset": {
                "time_series_dimension": true,
                "type": "keyword"
              }
            }
          },
          "settings": {
            "index": {
              "mode": "time_series",
              "number_of_replicas": 0,
              "number_of_shards": 1,
              "routing_path": [
                "metricset"
              ]
            }
          }
        }
      },
      "name": "tsdb-write-blocked-template"
    }
  },
  "response": {
    "headers": {
      "content-length": "21",
      "content-type": "application/json",
      "date": "Fri, 30 Oct 2026 10:18:47 GMT",
      "x-elastic-product": "Elasticsearch"
    },
    "payload": {
      "acknowledged": true
    },
    "statusCode": 200
  }
}