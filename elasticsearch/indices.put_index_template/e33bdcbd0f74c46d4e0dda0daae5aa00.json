{
  "api": "indices.put_index_template",
  "file": "/test/platinum/time_series/10_usage.yml",
  "name": "time_series usage",
  "origin": "yaml",
  "request": {
    "args": {
      "body": {
        "data_stream": {
        },
        "index_patterns": [
          "k8s-usage*"
        ],
        "template": {
          "mappings": {
            "properties": {
              "@timestamp": {
                "type": "date"
              },
              "metricset": {
                "time_series_dimension": true,
                "type": "keyword"
              },
              "value": {
                "type": "long"
              }
            }
          },
          "settings": {
            "index": {
              "mode": "time_series",
              "number_of_replicas": 0,
              "number_of_shards": 1,
              "routing_path": [
                "metricset"
              ],
              "time_series": {
                "end_time": "2021-04-29T00:00:00Z",
                "start_time": "2021-04-28T00:00:00Z"
              }
            }
          }
        }
      },
      "name": "tsdb-usage-template"
    }
  },
  "response": {
    "headers": {
      "content-length": "21",
      "content-type": "application/json",
      "date": "Sat, 17 Oct 2026 11:23:03 GMT",
      "x-elastic-product": "Elasticsearch"
    },
    "payload": {
      "acknowledged": true
    },
    "statusCode": 200
  }
}