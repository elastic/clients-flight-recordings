  "name": "DESCRIBE a bucket count bounded by the request filter",
  "origin": "yaml",
  "request": {
    "args": {
      "body": {
        "filter": {
          "range": {
            "@timestamp": {
              "gte": "2026-11-01T00:00:00Z",
              "lt": "2026-11-30T00:00:00Z"
