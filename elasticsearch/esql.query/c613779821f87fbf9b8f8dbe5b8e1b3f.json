      "body": {
        "query": "SET time_zone=\"+04:00\";\nFROM tzs\n| EVAL\n    hour=DATE_EXTRACT(\"hour_of_day\", @timestamp),\n    day_name=DAY_NAME(@timestamp),\n    month_name=MONTH_NAME(@timestamp)\n| SORT @timestamp ASC\n| LIMIT 5\n",
        "settings": {
          "time_zone": "Europe/Paris"
        }
      }
    }
