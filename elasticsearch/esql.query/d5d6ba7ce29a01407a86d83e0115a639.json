  "file": "/test/platinum/esql/48_column_semantics.yml",
  "name": "DESCRIBE a bucket count bounded by the request filter",
  "origin": "yaml",
  "request": {
    "args": {
      "body": {
        "filter": {
          "range": {
            "@timestamp": {
              "gte": "2026-11-01T00:00:00Z",
              "lt": "2026-11-30T00:00:00Z"
            }
          }
        },
        "query": "TS test_semantics | STATS avg = AVG(AVG_OVER_TIME(latency)) BY b = TBUCKET(20) | DESCRIBE | WHERE name == \"b\" | KEEP name, role, interval"
      }
    }
  },
