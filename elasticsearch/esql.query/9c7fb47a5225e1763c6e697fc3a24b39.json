{
  "api": "esql.query",
  "file": "/test/platinum/esql/307_nested_any.yml",
  "name": "NESTED_ANY reads a mapped child of any type like a column",
  "origin": "yaml",
  "request": {
    "args": {
      "body": {
        "query": "FROM nested_any_types | EVAL has_g = NESTED_ANY(ST_DISTANCE(items.g, TO_GEOPOINT(\"POINT(1 1)\")) < 1000),\n       has_dn = NESTED_ANY(items.dn > TO_DATE_NANOS(\"2020-01-01T00:00:00Z\")),\n       has_ul = NESTED_ANY(items.ul > TO_UNSIGNED_LONG(5)),\n       has_ver = NESTED_ANY(items.ver > TO_VERSION(\"1.0.0\")),\n       has_f = NESTED_ANY(items.f > 1.5),\n       has_hf = NESTED_ANY(items.hf > 1.5),\n       has_sf = NESTED_ANY(items.sf > 1.5),\n       has_d = NESTED_ANY(items.d > TO_DATETIME(\"2020-01-01T00:00:00Z\")),\n       has_ip = NESTED_ANY(CIDR_MATCH(items.ip, \"10.0.0.0/8\")),\n       has_b = NESTED_ANY(items.b)\n| KEEP id, has_g, has_dn, has_ul, has_ver, has_f, has_hf, has_sf, has_d, has_ip, has_b | SORT id\n"
      }
    }
  },
