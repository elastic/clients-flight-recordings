{
  "api": "transform.put_transform",
  "file": "/test/platinum/transform/transforms_update.yml",
  "name": "Test update indexer_request_timeout",
  "origin": "yaml",
  "request": {
    "args": {
      "body": {
        "dest": {
          "index": "airline-data-timeout"
        },
        "pivot": {
          "aggs": {
            "avg_response": {
              "avg": {
                "field": "responsetime"
              }
            }
          },
          "group_by": {
            "airline": {
              "terms": {
                "field": "airline"
              }
            }
          }
        },
        "settings": {
          "indexer_request_timeout": "5m"
        },
        "source": {
          "index": "airline-data"
        }
      },
      "transform_id": "indexer-timeout-transform"
    }
  },
  "response": {
    "headers": {
      "content-length": "21",
      "content-type": "application/json",
      "date": "Mon, 19 Oct 2026 11:21:50 GMT",
      "x-elastic-product": "Elasticsearch"
    },
    "payload": {
      "acknowledged": true
    },
    "statusCode": 200
  }
}