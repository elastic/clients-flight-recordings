{
  "api": "indices.put_data_lifecycle",
  "file": "/test/free/data_stream/lifecycle/20_basic.yml",
  "name": "Put data stream lifecycle with downsampling method",
  "origin": "yaml",
  "request": {
    "args": {
      "body": {
        "data_retention": "30d",
        "downsampling": [
          {
            "after": "10d",
            "fixed_interval": "1h"
          },
          {
            "after": "100d",
            "fixed_interval": "10h"
          }
        ],
        "downsampling_method": "aggregate",
        "enabled": false
      },
      "name": "*"
    }
  },
  "response": {
    "headers": {
      "content-length": "21",
      "content-type": "application/json",
      "date": "Wed, 02 Sep 2026 10:20:49 GMT",
      "x-elastic-product": "Elasticsearch"
    },
    "payload": {
      "acknowledged": true
    },
    "statusCode": 200
  }
}