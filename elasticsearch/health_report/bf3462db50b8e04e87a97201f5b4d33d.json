{
  "api": "health_report",
  "file": "/test/free/health/60_shards_capacity.yml",
  "name": "shards_capacity is green with verbose details",
  "origin": "yaml",
  "request": {
    "args": {
      "feature": "shards_capacity"
    }
  },
  "response": {
    "headers": {
      "content-type": "application/json",
      "date": "Tue, 29 Sep 2026 10:25:20 GMT",
      "transfer-encoding": "chunked",
      "x-elastic-product": "Elasticsearch"
    },
    "payload": {
      "cluster_name": "elasticsearch-x86-64-rest-test",
      "indicators": {
        "shards_capacity": {
          "details": {
            "data": {
              "max_shards_in_cluster": 1000
            },
            "frozen": {
              "max_shards_in_cluster": 3000
            }
          },
          "status": "green",
          "symptom": "The cluster has enough room to add new shards."
        }
      }
    },
    "statusCode": 200
  }
}