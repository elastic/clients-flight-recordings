{
  "api": "esql.get_view",
  "file": "/test/platinum/esql/200_view.yml",
  "name": "delete-multiple-views-with-wildcard",
  "origin": "yaml",
  "request": {
    "args": {
      "name": [
        "*",
        "-.*"
      ]
    }
  },
  "response": {
    "headers": {
      "content-length": "87",
      "content-type": "application/json",
      "date": "Wed, 21 Oct 2026 11:05:49 GMT",
      "x-elastic-product": "Elasticsearch"
    },
    "payload": {
      "views": [
        {
          "name": "faxes",
          "query": "FROM test | WHERE animal == \"office_appliance\""
        }
      ]
    },
    "statusCode": 200
  }
}