{
  "api": "esql.put_view",
  "file": "/test/platinum/esql/281_unmapped_load_subqueries_views.yml",
  "name": "FILLNULL inside a view without SET fills the view's columns under a load caller",
  "origin": "yaml",
  "request": {
    "args": {
      "body": {
        "query": "FROM idx1 | EVAL color = CASE(id == 1, null, color) | KEEP id, color | FILLNULL \"filled\" ON color"
