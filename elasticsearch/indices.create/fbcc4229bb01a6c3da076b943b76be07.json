{
  "api": "indices.create",
  "file": "/test/free/data_stream/290_columnar.yml",
  "name": "Create logsdb_columnar index, index docs, and retrieve them",
  "origin": "yaml",
  "request": {
    "args": {
      "body": {
        "mappings": {
          "properties": {
            "@timestamp": {
              "type": "date"
            },
            "agent_id": {
              "type": "keyword"
            },
            "host.name": {
              "type": "keyword"
            },
            "http_method": {
              "type": "keyword"
            },
            "message": {
              "type": "text"
            },
            "process_id": {
              "type": "integer"
            }
          }
        },
        "settings": {
          "index": {
            "mode": "logsdb_columnar",
            "number_of_replicas": 1,
            "number_of_shards": 2
          }
        }
      },
      "index": "test-columnar-logsdb"
    }
  },
  "response": {
    "headers": {
      "content-length": "79",
      "content-type": "application/json",
      "date": "Wed, 02 Sep 2026 10:19:48 GMT",
      "x-elastic-product": "Elasticsearch"
    },
    "payload": {
      "acknowledged": true,
      "index": "test-columnar-logsdb",
      "shards_acknowledged": true
    },
    "statusCode": 200
  }
}