{
  "api": "indices.create",
  "file": "/test/free/logsdb/30_composite_agg.yml",
  "name": "composite aggregation on fields backed only by a doc values skipper",
  "origin": "yaml",
  "request": {
    "args": {
      "body": {
        "mappings": {
          "properties": {
            "@timestamp": {
              "type": "date"
            },
            "host.name": {
              "type": "keyword"
            },
            "service": {
              "index": false,
              "type": "keyword"
            }
          }
        },
        "settings": {
          "index": {
            "mode": "logsdb",
            "sort": {
              "field": [
                "host.name",
                "@timestamp"
              ],
              "order": [
                "asc",
                "desc"
              ]
            }
          }
        }
      },
      "index": "test-composite"
    }
  },
  "response": {
    "headers": {
      "content-length": "73",
      "content-type": "application/json",
      "date": "Thu, 03 Sep 2026 10:27:32 GMT",
      "x-elastic-product": "Elasticsearch"
    },
    "payload": {
      "acknowledged": true,
      "index": "test-composite",
      "shards_acknowledged": true
    },
    "statusCode": 200
  }
}