{
  "api": "indices.create",
  "file": "/test/free/indices.sort/40_high_cardinality.yml",
  "name": "Index sort on high cardinality ip field",
  "origin": "yaml",
  "request": {
    "args": {
      "body": {
        "mappings": {
          "properties": {
            "addr": {
              "type": "ip"
            }
          }
        },
        "settings": {
          "auto_expand_replicas": "0-1",
          "index": {
            "mode": "columnar",
            "sort": {
              "field": "addr"
            }
          },
          "number_of_shards": 1,
          "refresh_interval": -1,
          "routing": {
            "rebalance": {
              "enable": "none"
            }
          }
        }
      },
      "index": "test_ip"
    }
  },
  "response": {
    "headers": {
      "content-length": "66",
      "content-type": "application/json",
      "date": "Fri, 30 Oct 2026 10:28:59 GMT",
      "x-elastic-product": "Elasticsearch"
    },
    "payload": {
      "acknowledged": true,
      "index": "test_ip",
      "shards_acknowledged": true
    },
    "statusCode": 200
  }
}