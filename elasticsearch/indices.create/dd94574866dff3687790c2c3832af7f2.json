{
  "api": "indices.create",
  "file": "/test/free/simulate.ingest/20_template_index_mode.yml",
  "name": "Simulate with an existing time_series index and a mapping addition",
  "origin": "yaml",
  "request": {
    "args": {
      "body": {
        "mappings": {
          "properties": {
            "@timestamp": {
              "type": "date"
            },
            "dim": {
              "time_series_dimension": true,
              "type": "keyword"
            }
          }
        },
        "settings": {
          "index": {
            "mode": "time_series",
            "routing_path": [
              "dim"
            ],
            "time_series": {
              "end_time": "2021-04-29T00:00:00Z",
              "start_time": "2021-04-28T00:00:00Z"
            }
          }
        }
      },
      "index": "tsdb-sim-existing"
    }
  },
  "response": {
    "headers": {
      "content-length": "76",
      "content-type": "application/json",
      "date": "Sat, 28 Nov 2026 10:42:13 GMT",
      "x-elastic-product": "Elasticsearch"
    },
    "payload": {
      "acknowledged": true,
      "index": "tsdb-sim-existing",
      "shards_acknowledged": true
    },
    "statusCode": 200
  }
}