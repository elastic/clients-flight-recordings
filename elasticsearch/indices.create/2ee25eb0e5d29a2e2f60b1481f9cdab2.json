{
  "api": "indices.create",
  "file": "/test/platinum/esql/341_index_sort_expression.yml",
  "name": "Sort expression configures the index sort",
  "origin": "yaml",
  "request": {
    "args": {
      "body": {
        "mappings": {
          "properties": {
            "rank": {
              "type": "long"
            }
          }
        },
        "settings": {
          "auto_expand_replicas": "0-1",
          "index": {
            "sort": "rank DESC"
          },
          "number_of_shards": 1,
          "routing": {
            "rebalance": {
              "enable": "none"
            }
          }
        }
      },
      "index": "sorted_index"
    }
  },
  "response": {
    "headers": {
      "content-length": "71",
      "content-type": "application/json",
      "date": "Sat, 28 Nov 2026 11:09:17 GMT",
      "x-elastic-product": "Elasticsearch"
    },
    "payload": {
      "acknowledged": true,
      "index": "sorted_index",
      "shards_acknowledged": true
    },
    "statusCode": 200
  }
}