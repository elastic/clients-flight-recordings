{
  "api": "indices.create",
  "file": "/test/platinum/esql/341_index_sort_expression.yml",
  "name": "Sort expression setting is idempotent across GET and PUT",
  "origin": "yaml",
  "request": {
    "args": {
      "body": {
        "mappings": {
          "properties": {
            "other": {
              "type": "long"
            },
            "rank": {
              "type": "long"
            }
          }
        },
        "settings": {
          "index": {
            "sort": "rank DESC NULLS LAST, MV_MAX(other)"
          },
          "number_of_shards": 1
        }
      },
      "index": "copied_index"
    }
  },
  "response": {
    "headers": {
      "content-length": "71",
      "content-type": "application/json",
      "date": "Sat, 28 Nov 2026 11:09:18 GMT",
      "x-elastic-product": "Elasticsearch"
    },
    "payload": {
      "acknowledged": true,
      "index": "copied_index",
      "shards_acknowledged": true
    },
    "statusCode": 200
  }
}