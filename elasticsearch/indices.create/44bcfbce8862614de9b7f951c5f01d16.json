{
  "api": "indices.create",
  "file": "/test/platinum/security/authz_api_keys/40_document_level_security_synthetic_source.yml",
  "name": "Filter on field within a disabled object in logsdb - uses _ignored_source doc values",
  "origin": "yaml",
  "request": {
    "args": {
      "body": {
        "mappings": {
          "properties": {
            "@timestamp": {
              "type": "date"
            },
            "name": {
              "type": "keyword"
            },
            "object": {
              "enabled": false,
              "type": "object"
            }
          },
          "runtime": {
            "secret": {
              "script": {
                "source": "emit(params._source.object.secret)"
              },
              "type": "keyword"
            }
          }
        },
        "settings": {
          "index": {
            "mode": "logsdb"
          }
        }
      },
      "index": "index_dls_logsdb"
    }
  },
  "response": {
    "headers": {
      "content-length": "75",
      "content-type": "application/json",
      "date": "Fri, 04 Sep 2026 11:33:22 GMT",
      "x-elastic-product": "Elasticsearch"
    },
    "payload": {
      "acknowledged": true,
      "index": "index_dls_logsdb",
      "shards_acknowledged": true
    },
    "statusCode": 200
  }
}