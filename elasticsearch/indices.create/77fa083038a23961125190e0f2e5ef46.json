{
  "api": "indices.create",
  "file": "/test/free/indices.sort/40_high_cardinality.yml",
  "name": "Index sort on high cardinality keyword field - explicit mode=min",
  "origin": "yaml",
  "request": {
    "args": {
      "body": {
        "mappings": {
          "properties": {
            "name": {
              "type": "keyword"
            }
          }
        },
        "settings": {
          "index": {
            "mode": "columnar",
            "sort": {
              "field": "name",
              "mode": "min"
            }
          },
          "number_of_shards": 1,
          "refresh_interval": -1,
          "routing": {
            "rebalance": {
              "enable": "none"
            }
          }
        }
      },
      "index": "test_mode_min"
    }
  },
  "response": {
    "headers": {
      "content-length": "72",
      "content-type": "application/json",
      "date": "Tue, 01 Sep 2026 10:25:57 GMT",
      "x-elastic-product": "Elasticsearch"
    },
    "payload": {
      "acknowledged": true,
      "index": "test_mode_min",
      "shards_acknowledged": true
    },
    "statusCode": 200
  }
}