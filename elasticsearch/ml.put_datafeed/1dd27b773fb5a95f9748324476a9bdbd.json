{
  "api": "ml.put_datafeed",
  "file": "/test/platinum/ml/datafeeds_esql_validation.yml",
  "name": "Test put ES|QL datafeed with a time column bucketed from the source time field",
  "origin": "yaml",
  "request": {
    "args": {
      "body": {
        "delayed_data_check_config": {
          "enabled": false
        },
        "esql_query": "FROM esql-feed-data | STATS c = COUNT(*) BY @timestamp = BUCKET(@timestamp, 1 hour)",
        "grouping_interval": "1h",
        "job_id": "esql-feed-job",
        "source_time_field": "@timestamp"
      },
      "datafeed_id": "esql-feed-bucket"
    },
    "headers": {
      "Authorization": "Basic eF9wYWNrX3Jlc3RfdXNlcjp4LXBhY2stdGVzdC1wYXNzd29yZA=="
    }
  },
  "response": {
    "headers": {
      "content-length": "253",
      "content-type": "application/json",
      "date": "Tue, 24 Nov 2026 11:32:11 GMT",
      "x-elastic-product": "Elasticsearch"
    },
    "payload": {
      "error": {
        "reason": "A datafeed [esql-feed-mapped] already exists for job [esql-feed-job]",
        "root_cause": [
          {
            "reason": "A datafeed [esql-feed-mapped] already exists for job [esql-feed-job]",
            "type": "status_exception"
          }
        ],
        "type": "status_exception"
      },
      "status": 409
    },
    "statusCode": 409
  }
}