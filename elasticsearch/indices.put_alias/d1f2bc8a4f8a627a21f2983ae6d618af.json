{
  "api": "indices.put_alias",
  "file": "/test/free/search.vectors/130_knn_query_nested_search.yml",
  "name": "Filter on nested fields via a filtered alias",
  "origin": "yaml",
  "request": {
    "args": {
      "body": {
        "filter": {
          "nested": {
            "path": "nested2",
            "query": {
              "bool": {
                "filter": [
                  {
                    "term": {
                      "nested2.key": "level"
                    }
                  },
                  {
                    "term": {
                      "nested2.value": "advanced"
                    }
                  }
                ]
              }
            }
          }
        }
      },
      "index": "test",
      "name": "filtered_alias"
    }
  },
  "response": {
    "headers": {
      "content-length": "36",
      "content-type": "application/json",
      "date": "Fri, 30 Oct 2026 10:40:59 GMT",
      "x-elastic-product": "Elasticsearch"
    },
    "payload": {
      "acknowledged": true,
      "errors": false
    },
    "statusCode": 200
  }
}