            "pruning_config": {
              "only_score_pruned_tokens": true,
              "tokens_freq_ratio_threshold": 4,
              "tokens_weight_threshold": 0.4
            },
            "query": "octopus comforter smells"
          }
        }
      },
      "index": "index-with-sparse-vector",
      "typed_keys": true
    }
