{
  "api": "search",
  "file": "/test/platinum/ml/sparse_vector_search.yml",
  "name": "Test sparse_vector search with a pruning configuration that only keeps pruned tokens",
  "origin": "yaml",
  "request": {
    "args": {
      "body": {
        "query": {
          "sparse_vector": {
            "field": "ml.tokens",
            "inference_id": "text_expansion_model",
