{
  "api": "search",
  "file": "/test/platinum/inference/100_semantic_text_auto_prefiltering.yml",
  "name": "Test wrapped queries on inference fields used as automatic prefilters do not overflow the stack",
  "origin": "yaml",
  "request": {
    "args": {
      "body": {
        "query": {
          "bool": {
            "must": [
              {
                "script_score": {
                  "query": {
                    "match": {
                      "dense_field_1": {
                        "query": "violins"
                      }
                    }
                  },
                  "script": {
                    "params": {
                      "min_score": 0
                    },
                    "source": "_score >= params.min_score ? 5 * _score : 0"
                  }
                }
              },
              {
                "script_score": {
                  "query": {
                    "match": {
                      "dense_field_2": {
                        "query": "cats"
                      }
                    }
                  },
                  "script": {
                    "params": {
                      "min_score": 0
                    },
                    "source": "_score >= params.min_score ? 5 * _score : 0"
                  }
                }
              }
            ]
          }
        }
      },
      "index": "test-index",
      "typed_keys": true
    }
  },
  "response": {
