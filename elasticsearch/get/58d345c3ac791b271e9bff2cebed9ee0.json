{
  "api": "get",
  "file": "/test/free/search.vectors/242_source_dense_vectors_not_indexed.yml",
  "name": "a partial update keeps the non-indexed vector",
  "origin": "yaml",
  "request": {
    "args": {
      "_source_exclude_vectors": false,
      "id": "1",
      "index": "test"
    },
