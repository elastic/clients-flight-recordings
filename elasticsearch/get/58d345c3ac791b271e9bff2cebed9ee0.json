      "date": "Wed, 09 Sep 2026 10:35:54 GMT",
      "x-elastic-product": "Elasticsearch"
    },
    "payload": {
      "_id": "1",
      "_index": "test",
      "_primary_term": 1,
      "_seq_no": 0,
      "_source": {
        "name": "cow.jpg",
        "vector": [
          1,
          2,
          3
        ]
      },
      "_version": 1,
      "found": true
    },
    "statusCode": 200
  }
