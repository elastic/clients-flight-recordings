{
  "api": "indices.get_mapping",
  "file": "/test/free/search.vectors/60_dense_vector_dynamic_mapping.yml",
  "name": "Fields mapped as dense_vector have correct cluster stats min max values",
  "origin": "yaml",
  "request": {
    "args": {
      "index": "foo-mapped-index"
    }
  },
  "response": {
