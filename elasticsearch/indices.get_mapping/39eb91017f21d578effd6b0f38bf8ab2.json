        "mappings": {
          "properties": {
            "my_dense_vector_field": {
              "dims": 1276,
              "index": true,
              "index_options": {
                "bits": 1,
                "cluster_size": 384,
                "default_visit_percentage": 0,
                "flat_index_threshold": -1,
                "rescore_vector": {
                  "oversample": 3
                },
                "type": "bbq_disk"
              },
              "similarity": "cosine",
              "type": "dense_vector"
            }
          }
        }
      }
    },
    "statusCode": 200
  }
}