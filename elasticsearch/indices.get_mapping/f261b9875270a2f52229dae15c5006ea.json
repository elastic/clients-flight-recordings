{
  "api": "indices.get_mapping",
  "file": "/test/free/search.vectors/60_dense_vector_dynamic_mapping.yml",
  "name": "Fields with nested float arrays within the threshold map index a nested dense_vector",
  "origin": "yaml",
  "request": {
    "args": {
      "index": "test-nested-index"
    }
  },
  "response": {
    "headers": {
      "content-type": "application/json",
      "transfer-encoding": "chunked",
      "x-elastic-product": "Elasticsearch"
    },
    "payload": {
      "test-nested-index": {
        "mappings": {
          "properties": {
            "my_nested_field": {
              "properties": {
                "my_field": {
                  "dims": 128,
                  "index": true,
                  "index_options": {
                    "bits": 4,
                    "cluster_size": 384,
                    "default_visit_percentage": 0,
                    "flat_index_threshold": -1,
                    "rescore_vector": {
                      "oversample": 3
                    },
                    "type": "bbq_disk"
                  },
                  "similarity": "cosine",
                  "type": "dense_vector"
                }
              },
              "type": "nested"
            }
          }
        }
      }
    },
    "statusCode": 200
  }
}