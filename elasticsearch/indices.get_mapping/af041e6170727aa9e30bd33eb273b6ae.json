{
  "api": "indices.get_mapping",
  "file": "/test/platinum/downsample/80_downsample_aggregate.yml",
  "name": "downsample aggregate field",
  "origin": "yaml",
  "request": {
    "args": {
      "index": "test-downsample"
    }
  },
  "response": {
    "headers": {
      "content-type": "application/json",
      "date": "Fri, 28 Aug 2026 10:45:31 GMT",
      "transfer-encoding": "chunked",
      "x-elastic-product": "Elasticsearch"
    },
    "payload": {
      "test-downsample": {
        "mappings": {
          "_data_stream_timestamp": {
            "enabled": true
          },
          "properties": {
            "@timestamp": {
              "meta": {
                "fixed_interval": "1h",
