              },
              "type": "date"
            },
            "sensor_id": {
              "time_series_dimension": true,
              "type": "keyword"
            },
            "temperature": {
              "default_metric": "sum",
              "metrics": [
                "min",
                "sum",
                "value_count"
              ],
              "time_series_metric": "gauge",
              "type": "aggregate_metric_double"
            }
          }
        }
      }
    },
    "statusCode": 200
  }
}