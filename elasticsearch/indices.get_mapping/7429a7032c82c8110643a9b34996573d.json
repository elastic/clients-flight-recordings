{
  "api": "indices.get_mapping",
  "file": "/test/free/mapping/50_columnar_cardinality_defaults.yml",
  "name": "Keyword sort field uses low-cardinality doc values by default in columnar mode",
  "origin": "yaml",
  "request": {
    "args": {
      "index": "test-keyword-sort-cardinality"
    }
  },
  "response": {
    "headers": {
      "content-type": "application/json",
      "transfer-encoding": "chunked",
      "x-elastic-product": "Elasticsearch"
    },
    "payload": {
      "test-keyword-sort-cardinality": {
        "mappings": {
          "properties": {
            "@timestamp": {
              "type": "date"
            },
            "data_field": {
              "type": "keyword"
            },
            "sort_field": {
              "doc_values": {
                "cardinality": "low"
              },
              "type": "keyword"
            }
          }
        }
      }
    },
    "statusCode": 200
  }
}