{
  "api": "indices.get_mapping",
  "file": "/test/free/data_stream/290_columnar.yml",
  "name": "Create logsdb_columnar index, index docs, and retrieve them",
  "origin": "yaml",
  "request": {
    "args": {
      "index": "test-columnar-logsdb"
    }
  },
  "response": {
    "headers": {
      "content-type": "application/json",
      "date": "Sun, 30 Aug 2026 10:18:19 GMT",
      "transfer-encoding": "chunked",
      "x-elastic-product": "Elasticsearch"
    },
    "payload": {
      "test-columnar-logsdb": {
        "mappings": {
          "_data_stream_timestamp": {
            "enabled": true
          },
          "properties": {
            "@timestamp": {
              "ignore_malformed": false,
              "type": "date"
            },
            "agent_id": {
              "type": "keyword"
            },
            "host.name": {
              "type": "keyword"
            },
            "http_method": {
              "type": "keyword"
            },
            "message": {
              "type": "text"
            },
            "process_id": {
              "type": "integer"
            }
          }
        }
      }
    },
    "statusCode": 200
  }
}