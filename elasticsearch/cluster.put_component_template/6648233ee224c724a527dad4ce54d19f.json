{
  "api": "cluster.put_component_template",
  "file": "/test/free/cluster.component_template/10_basic.yml",
  "name": "PUT component template with duplicate dynamic template names emits a warning",
  "origin": "yaml",
  "request": {
    "args": {
      "body": {
        "template": {
          "mappings": {
            "dynamic_templates": [
              {
                "my_template": {
                  "mapping": {
                    "type": "keyword"
                  },
                  "match": "foo_*"
                }
              },
              {
                "my_template": {
                  "mapping": {
                    "type": "text"
                  },
                  "match": "bar_*"
                }
              }
            ]
          }
        }
      },
      "name": "test-dup-dynamic-templates"
    }
  },
  "response": {
    "headers": {
      "content-length": "21",
      "content-type": "application/json",
      "date": "Fri, 16 Oct 2026 10:13:27 GMT",
      "warning": "299 Elasticsearch-9.6.0-aaf1f687a6286fe4b00570fdba656567e3056383 \"Dynamic template [my_template] in template [test-dup-dynamic-templates] is defined more than once. It is not defined which of the duplicate definitions takes effect. Defining multiple dynamic templates with the same name will be rejected in a future version.\"",
      "x-elastic-product": "Elasticsearch"
    },
    "payload": {
      "acknowledged": true
    },
    "statusCode": 200
  }
}